{
    "name": "happones/filament-jsoneditor",
    "description": "Filament's JSON Editor input",
    "keywords": [
        "happones",
        "laravel",
        "filament-jsoneditor",
        "jsoneditor"
    ],
    "homepage": "https://github.com/happones/filament-jsoneditor",
    "license": "MIT",
    "authors": [
        {
            "name": "Omar Hernandez",
            "email": "happones@hotmail.com",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16",
        "illuminate/contracts": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.0",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1",
        "phpstan/phpstan-phpunit": "^1.3",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ray": "^1.35"
    },
    "autoload": {
        "psr-4": {
            "Happones\\FilamentJsoneditor\\": "src",
            "Happones\\FilamentJsoneditor\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Happones\\FilamentJsoneditor\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Happones\\FilamentJsoneditor\\FilamentJsoneditorServiceProvider"
            ],
            "aliases": {
                "FilamentJsoneditor": "Happones\\FilamentJsoneditor\\Facades\\FilamentJsoneditor"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
